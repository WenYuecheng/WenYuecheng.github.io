    "astro": "7.2.6",
    "sharp": "0.35.3",
    "three": "0.185.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.62.1",
    "@types/three": "0.185.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
