---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Locale } from '../lib/routes';
import type { SiteContent } from '../data/content';
import BaseLayout from '../layouts/BaseLayout.astro';
import signalDusk from '../assets/photography/signal-dusk.jpg';
import frameCoast from '../assets/photography/frame-coast.jpg';
import artifactShore from '../assets/photography/artifact-shore.jpg';

interface Props {
  locale: Locale;
  content: SiteContent;
  photo: SiteContent['photography']['items'][number];
}

const { locale, content, photo } = Astro.props;
const photoAssets: Record<string, ImageMetadata> = {
  'signal-dusk': signalDusk,
  'frame-coast': frameCoast,
  'artifact-shore': artifactShore,
};
const index = content.photography.items.findIndex((item) => item.slug === photo.slug);
const previous = content.photography.items[(index + content.photography.items.length - 1) % content.photography.items.length];
const next = content.photography.items[(index + 1) % content.photography.items.length];
const prefix = locale === 'zh' ? '/zh' : '';
---
<BaseLayout locale={locale} content={content} title={`${photo.caption} — ${content.profile.name}`} description={photo.alt}>
  <article class="photo-case">
    <header class="shell photo-case-head">
      <a class="button" href={`${prefix}/#photography`}>← {locale === 'zh' ? '返回摄影' : 'Back to photography'}</a>
      <div>
        <p class="eyebrow">{String(index + 1).padStart(2, '0')} · {locale === 'zh' ? '场外笔记' : 'Field notes'}</p>
        <h1>{photo.caption}</h1>
        <p>{photo.alt}</p>
      </div>
    </header>
    <figure class="full-photo shell">
      <Picture data-full-photo src={photoAssets[photo.slug]} widths={[720, 1200, 1600]} sizes="(max-width: 680px) calc(100vw - 28px), min(1180px, calc(100vw - 48px))" formats={['avif', 'webp']} loading="eager" decoding="async" alt={photo.alt} />
      <figcaption><span>{photo.caption}</span><span>{locale === 'zh' ? '温悦成 摄' : 'Photographed by Yuecheng Wen'}</span></figcaption>
    </figure>
    <nav class="shell photo-case-nav" aria-label={locale === 'zh' ? '摄影作品导航' : 'Photography navigation'}>
      <a href={`${prefix}/photography/${previous.slug}/`}><span>← {locale === 'zh' ? '上一张' : 'Previous'}</span><strong>{previous.caption}</strong></a>
      <a href={`${prefix}/photography/${next.slug}/`}><span>{locale === 'zh' ? '下一张' : 'Next'} →</span><strong>{next.caption}</strong></a>
    </nav>
  </article>
</BaseLayout>
