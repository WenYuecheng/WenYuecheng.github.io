---
import { Picture } from 'astro:assets';
import type { Locale } from '../lib/routes';
import { localizedProjectPath } from '../lib/routes';
import type { SiteContent } from '../data/content';
import BaseLayout from '../layouts/BaseLayout.astro';
import portrait from '../assets/profile/yuecheng-portrait.jpg';
import photoOne from '../assets/photography/signal-dusk.jpg';
import photoTwo from '../assets/photography/frame-coast.jpg';
import photoThree from '../assets/photography/artifact-shore.jpg';

interface Props { locale: Locale; content: SiteContent }
const { locale, content } = Astro.props;
const photos = [photoOne, photoTwo, photoThree];
const facts = [
  { value: content.education.gpa, label: 'GPA' },
  { value: content.education.average, label: locale === 'zh' ? '加权均分' : 'Weighted average' },
  { value: content.education.rank, label: locale === 'zh' ? '专业排名' : 'Cohort rank' },
  { value: content.education.ielts, label: 'IELTS' },
];
---
<BaseLayout locale={locale} content={content}>
  <section class="hero" id="profile" aria-labelledby="hero-title">
    <div class="shell hero-grid">
      <div>
        <p class="eyebrow">Runtime Observatory · 2026</p>
        <h1 id="hero-title"><span>{locale === 'zh' ? '温悦成' : 'Yuecheng'}</span>{locale === 'en' && <span class="surname">Wen</span>}</h1>
        <p class="hero-copy">{content.profile.headline}</p>
        <p class="hero-intro">{content.profile.label} · {content.profile.location}<br />{content.profile.availability}</p>
        <div class="hero-actions">
          <a class="button primary" href="#systems">{content.labels.systems} <span aria-hidden="true">↓</span></a>
          <a class="button" href="mailto:15698557180@163.com">{content.labels.contact} <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <figure class="hero-portrait" data-hero-portrait-frame>
        <div class="portrait-aperture">
          <Picture src={portrait} widths={[520, 760, 1040]} sizes="(max-width: 980px) min(78vw, 620px), 42vw" formats={['avif', 'webp']} loading="eager" decoding="async" alt={locale === 'zh' ? '温悦成个人肖像' : 'Portrait of Yuecheng Wen'} data-hero-portrait />
          <span class="portrait-scan" aria-hidden="true"></span>
        </div>
        <figcaption><span>IDENTITY / 01</span><span><i></i>{locale === 'zh' ? '真实影像' : 'Captured light'}</span></figcaption>
      </figure>
    </div>
  </section>

  <section class="section shell" aria-labelledby="profile-title">
    <div class="section-head reveal"><div><p class="eyebrow">00 · Identity layer</p><h2 id="profile-title">{content.labels.academicProfile}</h2></div></div>
    <div class="profile-grid reveal">
      <aside class="profile-aside panel"><span class="profile-mark">01</span><p class="mono muted">SCU / CS<br />Agentic systems<br />Reliable AI</p></aside>
      <div class="profile-body panel"><p>{content.profile.introduction}</p></div>
    </div>
    <div class="facts reveal">
      {facts.map((fact) => <div class="fact"><strong>{fact.value}</strong><span>{fact.label}</span></div>)}
    </div>
  </section>

  <section class="section shell" id="education" aria-labelledby="education-title">
    <div class="section-head reveal"><div><p class="eyebrow">01 · Academic record</p><h2 id="education-title">{content.labels.education}</h2></div><p class="section-copy">{content.education.description}</p></div>
    <div class="education-grid">
      <div class="reveal">
        <div class="institution"><h3>{content.education.university}</h3><p>{content.education.degree}<br /><span class="mono">{content.education.period}</span></p></div>
        <ul class="award-list" aria-label={content.labels.awards}>{content.awards.map((award) => <li><span>{award.name}</span><time>{award.date}</time></li>)}</ul>
      </div>
      <div class="reveal">
        <p class="eyebrow">{content.labels.score}</p>
        <ul class="course-list">{content.courses.map((course) => <li><span>{course.name}</span><b>{course.score}</b></li>)}</ul>
      </div>
    </div>
  </section>

  <section class="section shell" id="interests" aria-labelledby="interests-title">
    <div class="section-head reveal"><div><p class="eyebrow">02 · Research vector</p><h2 id="interests-title">{content.labels.interests}</h2></div><p class="section-copy">{locale === 'zh' ? '以智能体系统为主线，研究如何让模型在复杂环境中可靠行动。' : 'Centered on agentic systems—and the question of how models can act reliably in complex environments.'}</p></div>
    <div class="interest-grid">{content.interests.map((interest, index) => <article class="interest reveal"><span class="interest-number">0{index + 1}</span><h3>{interest.name}</h3><p>{interest.description}</p></article>)}</div>
  </section>

  <section class="section shell" id="systems" aria-labelledby="systems-title">
    <div class="section-head reveal"><div><p class="eyebrow">03 · Engineered evidence</p><h2 id="systems-title">{content.labels.systems}</h2></div><p class="section-copy">{locale === 'zh' ? '每个项目都从问题、架构、个人贡献和评测证据展开，而不是技术名词堆砌。' : 'Each system is presented through its problem, architecture, personal contribution and evaluation evidence.'}</p></div>
    <div class="project-list">{content.projects.map((project, index) => <a class="project-card reveal" href={localizedProjectPath(locale, project.slug)} data-index={`0${index + 1}`} data-parallax style="transform: translateY(var(--parallax-y, 0px))"><div><p class="eyebrow">{project.eyebrow}</p><h3>{project.name}</h3><p class="project-summary">{project.summary}</p><div class="tags">{project.tags.map((tag) => <span class="tag">{tag}</span>)}</div></div><div class="project-side"><span class="project-status">● {project.status}</span><span class="project-arrow" aria-hidden="true">↗</span></div></a>)}</div>
  </section>

  <section class="section shell" id="experience" aria-labelledby="research-title">
    <div class="section-head reveal"><div><p class="eyebrow">04 · Research experience</p><h2 id="research-title">{content.labels.research}</h2></div></div>
    <article class="research-card reveal">
      <div class="research-signal" aria-hidden="true"><svg viewBox="0 0 220 220" fill="none"><path d="M35 151L86 62l44 90 31-61 25 60" stroke="currentColor" stroke-width="2"/><circle cx="86" cy="62" r="7" fill="currentColor"/><circle cx="130" cy="152" r="7" fill="currentColor"/><path d="M20 175h180M20 45h180" stroke="currentColor" opacity=".25" stroke-dasharray="4 7"/></svg></div>
      <div class="research-body"><p class="eyebrow">{content.research.venue}</p><h3>{content.research.name}</h3><p>{content.research.summary}</p><ul>{content.research.contributions.map((item) => <li>{item}</li>)}</ul><p class="metric-line">{content.research.metrics.join(' · ')}</p><div class="link-row">{content.research.links.map((link) => <a class="button" href={link.href} target="_blank" rel="noreferrer">{link.label} ↗</a>)}</div></div>
    </article>
  </section>

  <section class="section shell" id="skills" aria-labelledby="skills-title">
    <div class="section-head reveal"><div><p class="eyebrow">05 · Capability map</p><h2 id="skills-title">{content.labels.skills}</h2></div></div>
    <div class="skill-grid">{content.skills.map((skill) => <article class="skill-group reveal"><h3>{skill.group}</h3><ul>{skill.items.map((item) => <li class="tag">{item}</li>)}</ul></article>)}</div>
  </section>

  <section class="section shell" id="photography" aria-labelledby="photography-title">
    <div class="section-head reveal"><div><p class="eyebrow">06 · Outside the runtime</p><h2 id="photography-title">{content.photography.title}</h2></div><p class="section-copy">{content.photography.description}</p></div>
    <div class="photo-journal">{content.photography.items.map((item, index) => <figure class="photo-entry reveal"><a class="photo-link" data-photo-link href={`${locale === 'zh' ? '/zh' : ''}/photography/${item.slug}/`} aria-label={`${item.caption} — ${locale === 'zh' ? '完整查看' : 'View full photograph'}`}><Picture src={photos[index]} widths={[480, 800, 1200]} sizes="(max-width: 680px) calc(100vw - 28px), 66vw" formats={['avif', 'webp']} loading="lazy" decoding="async" alt={item.alt} /><span class="photo-open" aria-hidden="true">{locale === 'zh' ? '完整查看' : 'View full'} ↗</span></a><figcaption><span>{item.caption}</span><span>0{index + 1}</span></figcaption></figure>)}</div>
  </section>

  <section class="section shell" id="contact" aria-labelledby="contact-title">
    <div class="contact-card panel reveal"><p class="eyebrow">07 · Open channel</p><h2 id="contact-title">{content.labels.contact}</h2><p class="section-copy">{locale === 'zh' ? '欢迎交流智能体系统、可靠 AI、RAG 研究与研究生学习机会。' : 'Open to conversations about agentic systems, reliable AI, RAG research and postgraduate opportunities.'}</p><div class="contact-links">{content.socialLinks.map((link) => <a class="button" href={link.href} target={link.href.startsWith('mailto:') ? undefined : '_blank'} rel={link.href.startsWith('mailto:') ? undefined : 'noreferrer'}>{link.label} ↗</a>)}</div><span class="contact-orbit" aria-hidden="true"></span></div>
  </section>
</BaseLayout>
