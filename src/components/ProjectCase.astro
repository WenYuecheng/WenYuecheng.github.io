---
import type { Locale } from '../lib/routes';
import { localizedHomePath } from '../lib/routes';
import type { SiteContent } from '../data/content';
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props { locale: Locale; content: SiteContent; project: SiteContent['projects'][number] }
const { locale, content, project } = Astro.props;
const sections = [
  ['problem', content.labels.problem], ['role', content.labels.role], ['architecture', content.labels.architecture],
  ['contributions', content.labels.contributions], ['evaluation', content.labels.evaluation], ['technology', content.labels.technology], ['evidence', content.labels.evidence],
];
---
<BaseLayout locale={locale} content={content} title={`${project.name} — ${content.profile.name}`} description={project.summary} projectName={project.name}>
  <header class="case-hero">
    <div class="shell">
      <a class="button" href={`${localizedHomePath(locale)}#systems`}>← {content.labels.back}</a>
      <p class="eyebrow" style="margin-top:42px">{project.eyebrow}</p>
      <h1>{project.name}</h1>
      <p class="summary">{project.summary}</p>
      <div class="case-meta"><span class="tag">● {project.status}</span>{project.tags.map((tag) => <span class="tag">{tag}</span>)}</div>
      {project.slug === 'yuecheng-harness' && (
        <figure class="project-visual reveal">
          <img data-project-visual src="/projects/terminal-welcome.svg" alt={locale === 'zh' ? 'Yuecheng-Harness 终端欢迎界面' : 'Yuecheng-Harness terminal welcome screen'} loading="eager" decoding="async" />
          <figcaption><span>{locale === 'zh' ? '项目主界面' : 'Project interface'}</span><span>YUECHENG-HARNESS / V1.0</span></figcaption>
        </figure>
      )}
    </div>
  </header>
  <div class="shell case-layout">
    <nav class="case-index" aria-label={locale === 'zh' ? '案例目录' : 'Case study contents'}>{sections.map(([id, label], index) => <a href={`#${id}`}>0{index + 1} / {label}</a>)}</nav>
    <article>
      <section class="case-section reveal" id="problem"><p class="eyebrow">01</p><h2>{content.labels.problem}</h2><p>{project.problem}</p></section>
      <section class="case-section reveal" id="role"><p class="eyebrow">02</p><h2>{content.labels.role}</h2><p>{project.role}</p></section>
      <section class="case-section reveal" id="architecture"><p class="eyebrow">03</p><h2>{content.labels.architecture}</h2><ol class="architecture-flow">{project.architecture.map((item, index) => <li><span class="mono">0{index + 1}</span><br />{item}</li>)}</ol></section>
      <section class="case-section reveal" id="contributions"><p class="eyebrow">04</p><h2>{content.labels.contributions}</h2><ul>{project.contributions.map((item) => <li>{item}</li>)}</ul></section>
      <section class="case-section reveal" id="evaluation"><p class="eyebrow">05</p><h2>{content.labels.evaluation}</h2><ul>{project.evaluation.map((item) => <li>{item}</li>)}</ul></section>
      <section class="case-section reveal" id="technology"><p class="eyebrow">06</p><h2>{content.labels.technology}</h2><div class="tags">{project.technology.map((item) => <span class="tag">{item}</span>)}</div></section>
      <section class="case-section reveal" id="evidence"><p class="eyebrow">07</p><h2>{content.labels.evidence}</h2><div class="link-row">{project.links.map((link) => <a class="button primary" href={link.href} target="_blank" rel="noreferrer">{link.label} ↗</a>)}</div></section>
    </article>
  </div>
</BaseLayout>
