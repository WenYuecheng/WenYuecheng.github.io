---
import PhotographyCase from '../../../components/PhotographyCase.astro';
import { allContent } from '../../../data/content';

export function getStaticPaths() {
  return allContent.zh.photography.items.map((photo) => ({ params: { slug: photo.slug }, props: { photo } }));
}
const { photo } = Astro.props;
---
<PhotographyCase locale="zh" content={allContent.zh} photo={photo} />
